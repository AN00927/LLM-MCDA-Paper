+        return "missing"
+    try:
+        import pandas as pd
+        cols = [str(c).strip() for c in pd.read_excel(p, nrows=0, engine="openpyxl").columns]
+    except Exception:
+        return "missing"
+    return "complete" if RUN_FILE_FORMAT_COLUMN in cols else "old_format"
